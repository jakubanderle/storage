<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>cz.anderle.mizar</groupId>
    <artifactId>storage.client</artifactId>
    <version>0.1.0</version>
    <name>storage-client</name>
    <description>storage-client</description>

    <properties>
        <java.version>25</java.version>
        <openapi-generator.version>7.26.0</openapi-generator.version>
        <client.apipath>../api/storageapi.yaml</client.apipath>
        <client.package>cz.anderle.mizar.storage.client</client.package>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.openapitools</groupId>
            <artifactId>openapi-generator-maven-plugin</artifactId>
            <version>${openapi-generator.version}</version>
            <scope>compile</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.openapitools</groupId>
                <artifactId>openapi-generator-maven-plugin</artifactId>
                <version>${openapi-generator.version}</version>
                <executions>
                    <execution>
                        <id>generate-storage-api</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${client.apipath}</inputSpec>
                            <generatorName>java</generatorName>
                            <configOptions>
                                <library>restclient</library>
                                <openApiNullable>false</openApiNullable>
                                <useJakartaEe>true</useJakartaEe>

                                <apiPackage>${client.package}</apiPackage>
                                <modelPackage>${client.package}.model</modelPackage>
                                <invokerPackage>${client.package}.invoker</invokerPackage>
                            </configOptions>

                            <generateApiTests>false</generateApiTests>
                            <generateModelTests>false</generateModelTests>
                            <generateApiDocumentation>false</generateApiDocumentation>
                            <generateModelDocumentation>false</generateModelDocumentation>

                            <globalProperties>
                                <supportingFiles>
                                    ApiClient.java,
                                    JavaTimeFormatter.java,
                                    RFC3339DateFormat.java,
                                    ExceptionProvider.java,
                                    ServerConfiguration.java,
                                    ServerVariable.java,
                                    Authentication.java,
                                    ApiKeyAuth.java,
                                    HttpBasicAuth.java,
                                    HttpBearerAuth.java,
                                    HttpBearerAuthInterceptor.java
                                </supportingFiles>
                            </globalProperties>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
